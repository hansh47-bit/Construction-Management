# Copy to .env. This is sourced as Bash syntax; quote values containing spaces.
# The default is for Cloudflare Tunnel / an HTTPS reverse proxy on this server.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SESSION_COOKIE_SECURE=true

# To test directly at http://SERVER_IP:8080, explicitly change both settings:
# APP_BIND_ADDRESS=0.0.0.0
# SESSION_COOKIE_SECURE=false

# Keep this directory on persistent storage. Defaults to the package's var/.
# APP_DATA_DIR=/var/lib/inc-construction
# JAVA_BIN=/usr/bin/java
JAVA_OPTS='-Xms128m -Xmx512m'
APP_START_TIMEOUT=120
APP_STOP_TIMEOUT=45

# Account lock policy: positive integers. Restart the app after changing these.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Opt-in local H2 console. Open /h2-console/ and use H2 database credentials.
# Remote console access stays disabled; use an SSH tunnel for server maintenance.
H2_CONSOLE_ENABLED=false

# Backup output defaults to APP_DATA_DIR/backups. No automatic deletion or schedule.
# BACKUP_DIR=/mnt/backup/inc-construction
# For a systemd-managed app, set the service and run backup with service-control rights.
# BACKUP_SYSTEMD_SERVICE=construction-management.service
