[Unit]
Description=INC Construction Management
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=inc
Group=inc
WorkingDirectory=/opt/construction-management
ExecStart=/bin/bash /opt/construction-management/run.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=multi-user.target
